{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "com.teamzero.astravital.pwa",
  "name": "AstraVital AI - Astronaut Health & Digital Twin",
  "short_name": "AstraVital AI",
  "description": "Intelligent Astronaut Health Monitoring & Digital Twin Platform for NASA Space Apps Challenge 2026. Real-time biometrics, authentic NASA research data, 3D Digital Twin, Mars simulation, and AI clinical support.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#060a12",
  "background_color": "#030712",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "medical",
    "health",
    "education",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Mission Dashboard",
      "short_name": "Dashboard",
      "description": "Real-time crew biometric flight deck & vitals",
      "url": "/?view=dashboard",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Astronaut Digital Twin",
      "short_name": "Digital Twin",
      "description": "3D physiological avatar & organ stress hotspots",
      "url": "/?view=digital-twin",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Health Analytics",
      "short_name": "AI Analytics",
      "description": "Multi-astronaut crew triage & clinical assistant",
      "url": "/?view=astra-ai",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "NASA Research Explorer",
      "short_name": "OSDR Research",
      "description": "NASA Open Science Data Repository & GeneLab studies",
      "url": "/?view=osdr",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.teamzero.astravital",
      "id": "com.teamzero.astravital"
    }
  ],
  "prefer_related_applications": false
}

