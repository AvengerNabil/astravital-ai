<title>NASA Space Apps Challenge - 240 Seconds of Glory Presentation Script</title>
<style>
  body { font-family: 'Calibri', 'Segoe UI', Arial, sans-serif; font-size: 11pt; line-height: 1.5; color: #1F2937; margin: 30px; }
  h1 { font-size: 22pt; color: #0B3D91; border-bottom: 2px solid #0B3D91; padding-bottom: 6px; margin-bottom: 8px; }
  h2 { font-size: 14pt; color: #0284C7; margin-top: 22px; margin-bottom: 8px; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; }
  h3 { font-size: 12pt; color: #1E293B; margin-top: 14px; margin-bottom: 6px; }
  p { margin-bottom: 10px; }
  .badge { display: inline-block; padding: 2px 8px; font-weight: bold; font-size: 9pt; border-radius: 4px; }
  .badge-who { background-color: #DBEAFE; color: #1E40AF; }
  .badge-why { background-color: #FEE2E2; color: #991B1B; }
  .badge-what { background-color: #FEF3C7; color: #92400E; }
  .badge-how { background-color: #D1FAE5; color: #065F46; }
  .badge-impact { background-color: #EDE9FE; color: #5B21B6; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 18px; }
  th { background-color: #0B3D91; color: white; text-align: left; padding: 8px 10px; font-size: 10pt; }
  td { border: 1px solid #CBD5E1; padding: 8px 10px; font-size: 9.5pt; vertical-align: top; }
  tr:nth-child(even) { background-color: #F8FAFC; }
  .spoken-script { background-color: #F1F5F9; border-left: 4px solid #0B3D91; padding: 12px 16px; font-size: 11.5pt; font-style: italic; line-height: 1.6; margin: 12px 0; }
  .direction { font-style: normal; font-weight: bold; color: #D97706; }
  .callout { background-color: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; padding: 12px; margin-bottom: 15px; }
</style>
</head>
